{
  "manifest_version": 3,
  "name": "LinkOK – Verificador de Links",
  "version": "1.0.0",
  "description": "Verifica automaticamente os links de cada página e destaca os suspeitos ou perigosos.",
  "permissions": ["storage"],
  "host_permissions": ["https://safebrowsing.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["analyzer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkOK",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
